# ==============================================================================
# Docker & Права пользователя (заполняются через make init)
# ==============================================================================
COMPOSE_PROJECT_NAME=my-python-app
IMAGE_TAG=0.1.0
UID=1000
GID=1000

# ==============================================================================
# Порты хоста (публикуются на вашем компьютере: 127.0.0.1:ПОРТ)
# ==============================================================================
NGINX_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==============================================================================
# Секреты приложения (обязательные параметры)
# ==============================================================================
DB__POSTGRES_PASSWORD=admin
REDIS__PASSWORD=secret_redis_password
JWT__SECRET_KEY=change_me_to_at_least_32_bytes_super_secret_jwt_key
PASSWORD__PEPPER=change_me_to_random_secret_pepper_string